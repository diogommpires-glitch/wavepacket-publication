{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.css",
      "tests/*.ts",
      "tests/*.tsx",
      "tests/*.mjs",
      "scripts/*.mjs",
      "*.ts",
      "*.json",
      "!src/generated",
      "!package-lock.json",
      "!openapi.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "suspicious": { "noConfusingLabels": "error" } }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
