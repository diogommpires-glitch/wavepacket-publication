          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationReport": {
        "additionalProperties": true,
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/ValidationCase"
            },
            "title": "Cases",
