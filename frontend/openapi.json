                "type": "null"
              }
            ]
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "suite": {
            "enum": [
              "quick",
              "full"
            ],
            "title": "Suite",
            "type": "string"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValidationSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "suite",
          "status"
        ],
        "title": "ValidationReport",
        "type": "object"
